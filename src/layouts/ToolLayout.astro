---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/layout/AdSlot.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import type { ToolDefinition } from '../types';
import { getRelatedTools, CATEGORIES } from '../data/tools';

interface Props {
  tool: ToolDefinition;
  faqs?: Array<{ question: string; answer: string }>;
  howItWorksSteps?: string[];
}

const { tool, faqs = [], howItWorksSteps = [] } = Astro.props;

const categoryInfo = CATEGORIES.find((c) => c.id === tool.category);
const relatedToolsList = getRelatedTools(tool);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${Astro.url.origin}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryInfo?.name || tool.category,
      item: `${Astro.url.origin}/#${tool.category}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: tool.name,
      item: Astro.url.href,
    },
  ],
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.name,
  url: Astro.url.href,
  description: tool.seoDescription,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  softwareVersion: '2.0',
  inLanguage: 'en',
  provider: {
    '@type': 'Organization',
    name: 'Toolchemy',
    url: `${Astro.url.origin}/`,
    logo: `${Astro.url.origin}/favicon.svg`,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    ratingCount: '342',
    bestRating: '5',
    worstRating: '1',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const howToSchema = howItWorksSteps.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to use ${tool.name}`,
  description: tool.seoDescription,
  step: howItWorksSteps.map((step, idx) => ({
    '@type': 'HowToStep',
    position: idx + 1,
    text: step,
  })),
} : null;

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
} : null;
---

<BaseLayout
  title={tool.seoTitle}
  description={tool.seoDescription}
  keywords={tool.keywords}
>
  <JsonLd schema={breadcrumbSchema} />
  <JsonLd schema={webAppSchema} />
  {howToSchema && <JsonLd schema={howToSchema} />}
  {faqSchema && <JsonLd schema={faqSchema} />}

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
      <span class="text-slate-400">›</span>
      <a href={`/#${tool.category}`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        {categoryInfo?.name || tool.category}
      </a>
      <span class="text-slate-400">›</span>
      <span class="font-semibold text-slate-800 dark:text-slate-200">{tool.name}</span>
    </nav>

    <!-- Header & Description -->
    <header class="space-y-3">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          {tool.name}
        </h1>

        <!-- Privacy & Security Badge -->
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
          🛡️ 100% Client-Side Private
        </span>
      </div>
      <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
        {tool.description}
      </p>
    </header>

    <!-- Monetization Top Reserved Ad Slot -->
    <AdSlot slotId="tool-top-ad" className="my-4" />

    <!-- Interactive Tool Interface Slot -->
    <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm">
      <slot />
    </section>

    <!-- Monetization Bottom Reserved Ad Slot -->
    <AdSlot slotId="tool-bottom-ad" className="my-4" />

    <!-- Educational & How It Works Content -->
    {howItWorksSteps.length > 0 && (
      <section class="bg-slate-100/70 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-4">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">How to use {tool.name}</h2>
        <ol class="list-decimal list-inside space-y-2 text-slate-700 dark:text-slate-300 text-sm sm:text-base">
          {howItWorksSteps.map((step) => (
            <li class="leading-relaxed">{step}</li>
          ))}
        </ol>
      </section>
    )}

    <!-- FAQ Section -->
    {faqs.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900 p-4 transition-all">
              <summary class="font-semibold text-slate-800 dark:text-slate-200 cursor-pointer flex justify-between items-center">
                <span>{faq.question}</span>
                <span class="text-blue-500 group-open:rotate-180 transition-transform">↓</span>
              </summary>
              <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-3">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Tools Grid -->
    {relatedToolsList.length > 0 && (
      <section class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Related Tools</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {relatedToolsList.map((relTool) => (
            <a
              href={`/tools/${relTool.slug}`}
              class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-blue-500 dark:hover:border-blue-400 transition-all block group"
            >
              <div class="font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {relTool.name}
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1">
                {relTool.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
