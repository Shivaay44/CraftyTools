---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/layout/AdSlot.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import ToolContentGuide from '../components/seo/ToolContentGuide.astro';
import type { ToolDefinition } from '../types';
import { getRelatedTools, CATEGORIES } from '../data/tools';
import { generateToolPageSchemaGraph } from '../lib/seo/schemaGenerators';

interface Props {
  tool: ToolDefinition;
  faqs?: Array<{ question: string; answer: string }>;
  howItWorksSteps?: string[];
}

const { tool, faqs = [], howItWorksSteps = [] } = Astro.props;

const categoryInfo = CATEGORIES.find((c) => c.id === tool.category);
const relatedToolsList = getRelatedTools(tool);
const pageUrl = Astro.url.href.split('?')[0]; // Clean canonical URL without search queries
const origin = Astro.url.origin;

const defaultSteps = [
  `Open the ${tool.name} tool on Crafty Tool in your browser.`,
  `Select or drag-and-drop your input files or enter your data directly into the interactive workspace.`,
  `Adjust the parameters, filters, formats, or options to suit your exact requirements.`,
  `Process and download or copy your final result directly on your device with 100% local privacy.`,
];
const stepsToUse = howItWorksSteps && howItWorksSteps.length > 0 ? howItWorksSteps : defaultSteps;

const defaultFaqs = [
  {
    question: `Is ${tool.name} completely free to use?`,
    answer: `Yes! ${tool.name} on Crafty Tool is 100% free with no hidden paywalls, subscriptions, daily usage limits, or watermarks.`,
  },
  {
    question: `Are my files or data uploaded to your servers when using ${tool.name}?`,
    answer: `No. Crafty Tool is built on client-side local architecture. All computation and processing execute directly inside your browser sandbox using Web Workers, HTML5 Canvas, and Web Cryptography APIs. Your files never leave your device.`,
  },
  {
    question: `Does ${tool.name} work on mobile devices?`,
    answer: `Yes! You can use ${tool.name} smoothly on iOS (Safari, Chrome) and Android browsers without installing any third-party apps or browser extensions.`,
  },
  {
    question: `Why is client-side processing advantageous?`,
    answer: `Cloud-based tools may require uploading files to remote servers, waiting in network queues, and downloading files back. Client-side processing happens in your device's memory with zero upload delays and enhanced privacy.`,
  },
];
const allFaqs = faqs && faqs.length > 0 ? [...faqs, ...defaultFaqs.slice(1)] : defaultFaqs;

// Unified Schema.org Graph
const toolSchemaGraph = generateToolPageSchemaGraph({
  tool,
  origin,
  pageUrl,
  categoryName: categoryInfo?.name || tool.category,
  categorySlug: tool.category,
  faqs: allFaqs,
  howItWorksSteps: stepsToUse,
  ogImageUrl: `${origin}/favicon.svg`,
});
---

<BaseLayout
  title={tool.seoTitle}
  description={tool.seoDescription}
  canonicalUrl={pageUrl}
  keywords={tool.keywords}
>
  <JsonLd schema={toolSchemaGraph} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Home</a>
      <span class="text-slate-400">›</span>
      <a href={`/tools#${tool.category}`} class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
        {categoryInfo?.name || tool.category}
      </a>
      <span class="text-slate-400">›</span>
      <span class="font-semibold text-slate-800 dark:text-slate-200 truncate">{tool.name}</span>
    </nav>

    <!-- Header & Value Proposition -->
    <header class="space-y-2.5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
            {tool.name}
          </h1>

          <!-- In-Browser Badge -->
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
            🛡️ 100% In-Browser & Private
          </span>
        </div>

        <!-- Favorite / Star Tool Button -->
        <button
          type="button"
          id="favorite-toggle-btn"
          data-slug={tool.slug}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-amber-400 dark:hover:border-amber-400 text-xs font-semibold text-slate-700 dark:text-slate-300 transition-all cursor-pointer shadow-2xs"
          title="Save to favorites"
        >
          <span id="star-icon" class="text-slate-400">☆</span>
          <span id="star-label">Add to Favorites</span>
        </button>
      </div>

      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
        {tool.description}
      </p>
    </header>

    <!-- Interactive Tool Interface (Dominates First Viewport) -->
    <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-5 sm:p-7 shadow-sm">
      <slot />
    </section>

    <!-- Top Reserved Ad Slot -->
    <AdSlot slotId="tool-top-ad" className="my-2" />

    <!-- Supporting Information & Guides -->
    <div class="space-y-10 pt-4 border-t border-slate-200 dark:border-slate-800">
      <!-- 3 Key Value Cards -->
      <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2 shadow-2xs">
          <div class="text-2xl">🔒</div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white">Zero Server Uploads</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Your files remain strictly inside your browser memory. Designed for privacy-sensitive workflows with zero server retention.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2 shadow-2xs">
          <div class="text-2xl">⚡</div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white">Local Hardware Speed</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Processes data locally in your browser using JavaScript, Web Workers, and WebAssembly where supported.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2 shadow-2xs">
          <div class="text-2xl">🆓</div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white">Free & Watermark-Free</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Enjoy full access with zero registration, no artificial upload count limits, and clean outputs without branding watermarks.
          </p>
        </div>
      </section>

      <!-- Why Client-Side Processing Comparison -->
      <section class="p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-4">
        <h2 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white">
          Why Use In-Browser Processing?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {tool.name} processes everything entirely within your browser sandbox. Whether working with sensitive documents, media assets, or source code, local execution helps minimize exposure of private data.
        </p>

        <!-- Neutral, Credible Comparison Table -->
        <div class="overflow-x-auto pt-1">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400">
                <th class="py-2.5 px-3 font-bold uppercase tracking-wider">Feature</th>
                <th class="py-2.5 px-3 font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">Crafty Tool (In-Browser)</th>
                <th class="py-2.5 px-3 font-bold uppercase tracking-wider">Cloud-Based Tools</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
              <tr>
                <td class="py-2.5 px-3 font-semibold">Data Transmission</td>
                <td class="py-2.5 px-3 text-emerald-600 dark:text-emerald-400 font-bold">Local Execution (0 Server Uploads)</td>
                <td class="py-2.5 px-3 text-slate-500">May require uploading to remote servers</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold">Processing Location</td>
                <td class="py-2.5 px-3 text-emerald-600 dark:text-emerald-400 font-bold">Client-Side Device Memory</td>
                <td class="py-2.5 px-3 text-slate-500">Remote Cloud Instances / Queues</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold">Privacy Model</td>
                <td class="py-2.5 px-3 text-emerald-600 dark:text-emerald-400 font-bold">Files remain on your device</td>
                <td class="py-2.5 px-3 text-slate-500">Files handled by third-party infrastructure</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold">Limits & Watermarks</td>
                <td class="py-2.5 px-3 text-emerald-600 dark:text-emerald-400 font-bold">No artificial paywalls or watermarks</td>
                <td class="py-2.5 px-3 text-slate-500">Often limited on free tiers</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Step-by-Step How To Guide -->
      <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 space-y-4 shadow-2xs">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📖 How to Use {tool.name}</span>
        </h2>
        <ol class="list-decimal list-inside space-y-2.5 text-slate-700 dark:text-slate-300 text-xs sm:text-sm">
          {stepsToUse.map((step) => (
            <li class="leading-relaxed pl-1">{step}</li>
          ))}
        </ol>
      </section>

      <!-- Tool-Specific Technical Specifications -->
      <ToolContentGuide tool={tool} />

      <!-- Frequently Asked Questions (FAQ) -->
      <section class="space-y-4">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>❓ Frequently Asked Questions</span>
        </h2>
        <div class="space-y-3">
          {allFaqs.map((faq) => (
            <details class="group border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900 p-4 transition-all open:ring-1 open:ring-purple-500/30">
              <summary class="font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-200 cursor-pointer flex justify-between items-center select-none">
                <span>{faq.question}</span>
                <span class="text-purple-500 font-bold group-open:rotate-180 transition-transform text-xs">▼</span>
              </summary>
              <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-3">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- Contextual Related Utilities -->
      {relatedToolsList.length > 0 && (
        <section class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
          <div class="flex items-center justify-between">
            <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">Related Utilities</h2>
            <a href="/tools" class="text-xs font-bold text-purple-600 dark:text-purple-400 hover:underline">
              Explore All 55 Tools →
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3.5">
            {relatedToolsList.map((relTool) => (
              <a
                href={`/tools/${relTool.slug}`}
                class="p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-purple-500 dark:hover:border-purple-400 transition-all block group shadow-2xs hover:shadow-md"
              >
                <div class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                  {relTool.name}
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1">
                  {relTool.description}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>

  <!-- Client Script for Favorites & Recents Tracking -->
  <script is:inline define:vars={{ toolSlug: tool.slug }}>
    // Record tool to recents
    try {
      const recentsKey = 'craftytool_recent_tools';
      const existing = JSON.parse(localStorage.getItem(recentsKey) || '[]');
      const updated = [toolSlug, ...existing.filter((s) => s !== toolSlug)].slice(0, 8);
      localStorage.setItem(recentsKey, JSON.stringify(updated));
    } catch (e) {
      console.warn('Recents storage error:', e);
    }

    // Favorite Button Handler
    const favBtn = document.getElementById('favorite-toggle-btn');
    const starIcon = document.getElementById('star-icon');
    const starLabel = document.getElementById('star-label');

    const updateFavUI = () => {
      try {
        const starsKey = 'craftytool_starred_tools';
        const stars = JSON.parse(localStorage.getItem(starsKey) || '[]');
        const isStarred = stars.includes(toolSlug);
        if (starIcon) {
          starIcon.textContent = isStarred ? '★' : '☆';
          starIcon.className = isStarred ? 'text-amber-500 font-bold text-sm' : 'text-slate-400';
        }
        if (starLabel) {
          starLabel.textContent = isStarred ? 'Favorited' : 'Add to Favorites';
        }
      } catch (e) {}
    };

    updateFavUI();

    if (favBtn) {
      favBtn.addEventListener('click', () => {
        try {
          const starsKey = 'craftytool_starred_tools';
          const stars = JSON.parse(localStorage.getItem(starsKey) || '[]');
          const isStarred = stars.includes(toolSlug);
          const updated = isStarred ? stars.filter((s) => s !== toolSlug) : [...stars, toolSlug];
          localStorage.setItem(starsKey, JSON.stringify(updated));
          updateFavUI();
        } catch (e) {
          console.warn('Star storage error:', e);
        }
      });
    }
  </script>
</BaseLayout>
