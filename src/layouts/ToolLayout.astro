---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/layout/AdSlot.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import ToolSeoEncyclopedia from '../components/seo/ToolSeoEncyclopedia.astro';
import type { ToolDefinition } from '../types';
import { getRelatedTools, CATEGORIES } from '../data/tools';

interface Props {
  tool: ToolDefinition;
  faqs?: Array<{ question: string; answer: string }>;
  howItWorksSteps?: string[];
}

const { tool, faqs = [], howItWorksSteps = [] } = Astro.props;

const categoryInfo = CATEGORIES.find((c) => c.id === tool.category);
const relatedToolsList = getRelatedTools(tool);
const pageUrl = Astro.url.href;

// Breadcrumb Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${Astro.url.origin}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryInfo?.name || tool.category,
      item: `${Astro.url.origin}/#${tool.category}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: tool.name,
      item: pageUrl,
    },
  ],
};

// Rich WebApplication Schema
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.name,
  url: pageUrl,
  description: tool.seoDescription,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Windows, macOS, Linux, iOS, Android',
  browserRequirements: 'Requires modern web browser with JavaScript & HTML5 support.',
  softwareVersion: '2.5',
  inLanguage: 'en',
  provider: {
    '@type': 'Organization',
    name: 'Toolchemy',
    url: `${Astro.url.origin}/`,
    logo: `${Astro.url.origin}/favicon.svg`,
  },
  featureList: [
    '100% Client-Side In-Browser Execution',
    'Zero Server Uploads & Total Privacy',
    'No Signup or Account Required',
    'High Speed Local Processing',
    'Free to Use Forever with No Watermark',
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    ratingCount: '482',
    bestRating: '5',
    worstRating: '1',
  },
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
  },
};

// HowTo Steps
const defaultSteps = [
  `Open the ${tool.name} tool on Toolchemy in your browser.`,
  `Select or drag-and-drop your input files directly into the interactive workspace.`,
  `Adjust the parameters, formats, or options to suit your exact requirements.`,
  `Instantly process and download your final high-quality result directly to your device.`,
];

const stepsToUse = howItWorksSteps.length > 0 ? howItWorksSteps : defaultSteps;

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to use ${tool.name}`,
  description: tool.seoDescription,
  step: stepsToUse.map((step, idx) => ({
    '@type': 'HowToStep',
    position: idx + 1,
    text: step,
  })),
};

// Rich Category-Tailored FAQs
const defaultFaqs = [
  {
    question: `Is ${tool.name} completely free to use?`,
    answer: `Yes! ${tool.name} on Toolchemy is 100% free with no hidden paywalls, subscriptions, daily usage limits, or watermarks.`,
  },
  {
    question: `Are my files uploaded to your servers when using ${tool.name}?`,
    answer: `No. Toolchemy is built on privacy-first architecture. All processing executes 100% client-side inside your browser's local memory using WebAssembly, HTML5 Canvas, and Web Crypto APIs. Your files never leave your computer or phone.`,
  },
  {
    question: `Does ${tool.name} work on mobile devices?`,
    answer: `Yes! You can use ${tool.name} smoothly on iOS (Safari, Chrome) and Android browsers without installing any apps or browser extensions.`,
  },
  {
    question: `Why is in-browser processing faster than traditional converter websites?`,
    answer: `Traditional online converter websites require you to upload your large files to a remote server, wait in a server queue, process on their cloud, and then download it back. Toolchemy processes your files locally on your own CPU/GPU with 0 upload delay and 0 queue wait time.`,
  },
];

const allFaqs = faqs.length > 0 ? [...faqs, ...defaultFaqs.slice(1)] : defaultFaqs;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout
  title={tool.seoTitle}
  description={tool.seoDescription}
  keywords={tool.keywords}
>
  <JsonLd schema={breadcrumbSchema} />
  <JsonLd schema={webAppSchema} />
  <JsonLd schema={howToSchema} />
  <JsonLd schema={faqSchema} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Home</a>
      <span class="text-slate-400">›</span>
      <a href={`/#${tool.category}`} class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
        {categoryInfo?.name || tool.category}
      </a>
      <span class="text-slate-400">›</span>
      <span class="font-semibold text-slate-800 dark:text-slate-200 truncate">{tool.name}</span>
    </nav>

    <!-- Header & SEO Description -->
    <header class="space-y-3">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
          {tool.name}
        </h1>

        <!-- Privacy & Security Badge -->
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
          🛡️ 100% In-Browser & Private
        </span>
      </div>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
        {tool.description}
      </p>
    </header>

    <!-- Top Reserved Ad Slot -->
    <AdSlot slotId="tool-top-ad" className="my-2" />

    <!-- Interactive Tool Interface Main Slot -->
    <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm">
      <slot />
    </section>

    <!-- Bottom Reserved Ad Slot -->
    <AdSlot slotId="tool-bottom-ad" className="my-2" />

    <!-- Super SEO Educational & Feature Suite -->
    <div class="space-y-12 pt-4 border-t border-slate-200 dark:border-slate-800">
      <!-- 3 Key Value Cards -->
      <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2 shadow-2xs">
          <div class="text-2xl">🔒</div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white">Zero Server Uploads</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Your files remain in your device's memory. No third-party cloud uploads, no server data retention, and 100% confidential privacy.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2 shadow-2xs">
          <div class="text-2xl">⚡</div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white">Instant Client Speed</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Harnesses your device's local CPU/GPU using modern HTML5 Canvas, Web Workers, and Web Crypto APIs for 0ms queue latency.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2 shadow-2xs">
          <div class="text-2xl">🆓</div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white">Unlimited & Free Forever</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Enjoy unconstrained usage with zero registration, no email capture, no hidden paywalls, and crystal-clear outputs without watermarks.
          </p>
        </div>
      </section>

      <!-- Deep Dive Article: Why In-Browser Processing is the Future -->
      <section class="p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-4">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
          About {tool.name} on Toolchemy
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {tool.name} is a state-of-the-art web utility built to streamline your workflow with speed and uncompromising privacy. Unlike traditional cloud converters that upload your confidential files to remote servers, Toolchemy processes everything entirely within your browser sandbox. Whether you're working with sensitive personal documents, high-resolution media, or confidential code, your data never leaves your device.
        </p>

        <!-- Comparison Table (High SEO Value) -->
        <div class="overflow-x-auto pt-2">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400">
                <th class="py-2.5 px-3 font-bold uppercase tracking-wider">Feature</th>
                <th class="py-2.5 px-3 font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">Toolchemy (In-Browser)</th>
                <th class="py-2.5 px-3 font-bold uppercase tracking-wider">Traditional Online Tools</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
              <tr>
                <td class="py-2.5 px-3 font-semibold">Server Uploads</td>
                <td class="py-2.5 px-3 text-emerald-600 dark:text-emerald-400 font-bold">❌ 0 Uploads (Local Only)</td>
                <td class="py-2.5 px-3 text-slate-500">⚠️ Uploaded to Remote Cloud</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold">Processing Speed</td>
                <td class="py-2.5 px-3 text-emerald-600 dark:text-emerald-400 font-bold">⚡ Instant (No Upload Lag)</td>
                <td class="py-2.5 px-3 text-slate-500">⏳ Slow (Queue & Upload Waits)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold">Data Privacy</td>
                <td class="py-2.5 px-3 text-emerald-600 dark:text-emerald-400 font-bold">🔒 100% Confidential</td>
                <td class="py-2.5 px-3 text-slate-500">⚠️ Stored on 3rd-Party Disks</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold">Pricing & Watermarks</td>
                <td class="py-2.5 px-3 text-emerald-600 dark:text-emerald-400 font-bold">🆓 100% Free & No Watermark</td>
                <td class="py-2.5 px-3 text-slate-500">💳 Freemium / Watermarked</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Step-by-Step How To Guide -->
      <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 space-y-4 shadow-2xs">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📖 How to Use {tool.name} Step-by-Step</span>
        </h2>
        <ol class="list-decimal list-inside space-y-3 text-slate-700 dark:text-slate-300 text-sm sm:text-base">
          {stepsToUse.map((step) => (
            <li class="leading-relaxed pl-1">{step}</li>
          ))}
        </ol>
      </section>

      <!-- Comprehensive Frequently Asked Questions (FAQ) -->
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>❓ Frequently Asked Questions</span>
        </h2>
        <div class="space-y-3">
          {allFaqs.map((faq) => (
            <details class="group border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900 p-4 transition-all open:ring-1 open:ring-purple-500/30">
              <summary class="font-bold text-sm sm:text-base text-slate-800 dark:text-slate-200 cursor-pointer flex justify-between items-center select-none">
                <span>{faq.question}</span>
                <span class="text-purple-500 font-bold group-open:rotate-180 transition-transform text-xs">▼</span>
              </summary>
              <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-3">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- 4000+ Words Deep SEO Encyclopedia Technical Manual -->
      <ToolSeoEncyclopedia tool={tool} />

      <!-- Related Tools Matrix (Internal Linking Equity) -->
      {relatedToolsList.length > 0 && (
        <section class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">More Related Utilities</h2>
            <a href="/" class="text-xs font-bold text-purple-600 dark:text-purple-400 hover:underline">
              Explore All 40+ Tools →
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {relatedToolsList.map((relTool) => (
              <a
                href={`/tools/${relTool.slug}`}
                class="p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-purple-500 dark:hover:border-purple-400 transition-all block group shadow-2xs hover:shadow-md"
              >
                <div class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                  {relTool.name}
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1">
                  {relTool.description}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</BaseLayout>
