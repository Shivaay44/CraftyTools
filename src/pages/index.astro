---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { CATEGORIES, TOOLS } from '../data/tools';
import { InteractiveToolExplorer } from '../components/home/InteractiveToolExplorer';
import { generateHomePageSchemaGraph } from '../lib/seo/schemaGenerators';
import {
  Zap,
  Lock,
  HardDrive,
  Sparkles,
  ArrowRight,
  ShieldCheck,
  Flame,
  Layers,
} from 'lucide-react';

const origin = Astro.url.origin;

// Unified Schema.org Graph for Homepage
const homeSchemaGraph = generateHomePageSchemaGraph({
  origin,
  tools: TOOLS,
  ogImageUrl: `${origin}/favicon.svg`,
});

// Category counts computation
const categoryToolCounts: Record<string, number> = {};
CATEGORIES.forEach((cat) => {
  categoryToolCounts[cat.id] = TOOLS.filter((t) => t.category === cat.id).length;
});

// Popular curated tools for hero section
const POPULAR_TOOLS_LIST = [
  { name: 'Image Compressor', slug: 'image-compressor', icon: '⚡', category: 'image' },
  { name: 'Merge PDF', slug: 'merge-pdf', icon: '📄', category: 'pdf' },
  { name: 'JSON Formatter', slug: 'json-formatter', icon: '💻', category: 'developer' },
  { name: 'QR Generator', slug: 'qr-code-generator', icon: '📱', category: 'developer' },
  { name: 'Password Generator', slug: 'password-generator', icon: '🔑', category: 'text' },
  { name: 'Age Calculator', slug: 'age-calculator', icon: '🎂', category: 'calculator' },
  { name: 'Regex Tester', slug: 'regex-tester', icon: '🔍', category: 'developer' },
  { name: 'Loan EMI Calculator', slug: 'loan-emi-calculator', icon: '💰', category: 'calculator' },
];

// Smart Multi-Step Workflows
const SMART_WORKFLOWS = [
  {
    title: 'Media Optimization Pipeline',
    description: 'Compress high-resolution photos, crop aspect ratios, and convert to WebP in seconds.',
    category: 'Images & Photos',
    accentColor: 'from-pink-500/20 to-purple-500/10 border-pink-500/30',
    steps: [
      { name: 'Image Compressor', slug: 'image-compressor' },
      { name: 'Image Cropper', slug: 'image-cropper' },
      { name: 'Format Converter', slug: 'image-format-converter' },
    ],
  },
  {
    title: 'Document Assembly Pipeline',
    description: 'Merge multi-source PDF documents, extract select pages, and stamp sequential numbering.',
    category: 'PDF & Documents',
    accentColor: 'from-red-500/20 to-amber-500/10 border-red-500/30',
    steps: [
      { name: 'Merge PDF', slug: 'merge-pdf' },
      { name: 'Remove Pages', slug: 'remove-pdf-pages' },
      { name: 'Page Numberer', slug: 'pdf-page-numberer' },
    ],
  },
  {
    title: 'Developer Payload Pipeline',
    description: 'Transform CSV datasets to JSON, format indented objects, and generate type definitions.',
    category: 'Data & Engineering',
    accentColor: 'from-emerald-500/20 to-cyan-500/10 border-emerald-500/30',
    steps: [
      { name: 'CSV to JSON', slug: 'csv-json-converter' },
      { name: 'JSON Formatter', slug: 'json-formatter' },
      { name: 'JWT Decoder', slug: 'jwt-decoder' },
    ],
  },
];
---

<BaseLayout
  title="Crafty Tool — Free Online In-Browser Utilities & Developer Toolbox"
  description="Fast, client-side digital utilities for developers, creators, and professionals. Compress images, convert PDFs, format data, and run calculations locally without uploading files. Private by Design."
  canonicalUrl={`${origin}/`}
  keywords={[
    'crafty tool',
    'free online tools',
    'in-browser utilities',
    'client side tools',
    'developer utilities',
    'privacy first tools',
    'free web tools',
  ]}
>
  <JsonLd schema={homeSchemaGraph} />

  <!-- Ambient Glowing Background Accents -->
  <div class="relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[850px] h-[450px] bg-gradient-to-tr from-purple-600/15 via-indigo-600/10 to-sky-500/10 blur-[130px] rounded-full pointer-events-none -z-10 animate-aurora"></div>
    <div class="absolute top-80 right-10 w-[400px] h-[400px] bg-pink-500/10 blur-[110px] rounded-full pointer-events-none -z-10"></div>
    <div class="absolute top-96 left-10 w-[350px] h-[350px] bg-cyan-500/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16 sm:space-y-24">
      <!-- 1. HERO SECTION -->
      <section class="text-center space-y-6 max-w-3xl mx-auto pt-2">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-purple-50 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800 shadow-2xs">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Your Everyday Browser Toolbox</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.12]">
          Crafty Tool — Free Online In-Browser Utilities <br />
          <span class="bg-gradient-to-r from-purple-600 via-indigo-500 to-sky-400 bg-clip-text text-transparent">
            No Signup. No Uploads. 100% Local Processing.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto">
          Compress images, convert PDFs, format JSON, and run developer utilities directly inside your browser sandbox with no upload/download processing round-trip.
        </p>

        <!-- Core Value Proposition Badges -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <div class="flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xs border border-slate-200 dark:border-slate-800 shadow-2xs text-xs font-bold text-slate-800 dark:text-slate-200">
            <span class="text-amber-500 text-sm">⚡</span>
            <span>No Upload Wait</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xs border border-slate-200 dark:border-slate-800 shadow-2xs text-xs font-bold text-slate-800 dark:text-slate-200">
            <span class="text-emerald-500 text-sm">🔒</span>
            <span>Private by Design</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xs border border-slate-200 dark:border-slate-800 shadow-2xs text-xs font-bold text-slate-800 dark:text-slate-200">
            <span class="text-blue-500 text-sm">🖥️</span>
            <span>Runs Locally</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/80 dark:bg-slate-900/80 backdrop-blur-xs border border-slate-200 dark:border-slate-800 shadow-2xs text-xs font-bold text-slate-800 dark:text-slate-200">
            <span class="text-purple-500 text-sm">∞</span>
            <span>Free to Use</span>
          </div>
        </div>
      </section>

      <!-- 2. POPULAR TOOLS ROW (Quick Access) -->
      <section class="space-y-3 max-w-5xl mx-auto">
        <div class="flex items-center justify-between px-1">
          <h2 class="flex items-center gap-2 text-xs font-bold text-slate-600 dark:text-slate-400 uppercase tracking-widest">
            <Flame className="w-3.5 h-3.5 text-amber-500" />
            <span>Popular Utilities</span>
          </h2>
          <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Click to launch</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
          {POPULAR_TOOLS_LIST.map((tool) => (
            <a
              href={`/tools/${tool.slug}`}
              class="group p-3 sm:p-3.5 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 hover:border-purple-500 dark:hover:border-purple-400 hover:shadow-md hover:shadow-purple-500/10 transition-all flex items-center justify-between cursor-pointer select-none"
            >
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="text-base sm:text-lg flex-shrink-0 group-hover:scale-110 transition-transform">
                  {tool.icon}
                </span>
                <span class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200 truncate group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                  {tool.name}
                </span>
              </div>
              <ArrowRight className="w-3.5 h-3.5 text-slate-300 dark:text-slate-600 group-hover:text-purple-500 group-hover:translate-x-0.5 transition-all flex-shrink-0 ml-1" />
            </a>
          ))}
        </div>
      </section>

      <!-- 3. EXPLORE BY CATEGORY GRID -->
      <section class="space-y-6">
        <div class="text-center space-y-2 max-w-2xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
            Explore 55+ Utilities by Category
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            Built for creators, developers, professionals, and everyday productivity.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
          {CATEGORIES.map((cat) => {
            const count = categoryToolCounts[cat.id] || 0;
            return (
              <a
                href={`/tools#${cat.id}`}
                class="group p-4 sm:p-5 rounded-3xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 hover:border-purple-500 dark:hover:border-purple-400 hover:shadow-lg hover:shadow-purple-500/10 transition-all flex flex-col items-center text-center space-y-2 cursor-pointer"
              >
                <div class="w-11 h-11 rounded-2xl bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-lg group-hover:scale-110 transition-transform">
                  {cat.id === 'image' && '🖼️'}
                  {cat.id === 'pdf' && '📄'}
                  {cat.id === 'video' && '🎥'}
                  {cat.id === 'text' && '✍️'}
                  {cat.id === 'developer' && '⚡'}
                  {cat.id === 'calculator' && '🔢'}
                </div>
                <div>
                  <div class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                    {cat.name}
                  </div>
                  <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mt-0.5">
                    {count} {count === 1 ? 'Tool' : 'Tools'}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      <!-- 4. SMART WORKFLOWS SECTION -->
      <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2 text-xs font-bold text-purple-600 dark:text-purple-400 uppercase tracking-wider">
              <Layers className="w-3.5 h-3.5" />
              <span>Multi-Step Productivity</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              Interactive Tool Workflows
            </h2>
          </div>
          <a href="/workflows" class="text-xs font-bold text-purple-600 dark:text-purple-400 hover:underline flex items-center gap-1">
            <span>Run Workflows Engine</span>
            <ArrowRight className="w-3.5 h-3.5" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {SMART_WORKFLOWS.map((wf) => (
            <div
              class={`p-6 rounded-3xl bg-gradient-to-br bg-white dark:bg-slate-900 border ${wf.accentColor} shadow-sm space-y-4 flex flex-col justify-between`}
            >
              <div class="space-y-2">
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                  {wf.category}
                </span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">
                  {wf.title}
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                  {wf.description}
                </p>
              </div>

              <!-- Step Sequence Pills -->
              <div class="space-y-1.5 pt-2 border-t border-slate-100 dark:border-slate-800/80">
                {wf.steps.map((step, idx) => (
                  <a
                    href={`/tools/${step.slug}`}
                    class="flex items-center justify-between p-2 rounded-xl bg-slate-50/80 dark:bg-slate-800/60 hover:bg-purple-50 dark:hover:bg-purple-950/60 transition-colors text-xs font-semibold text-slate-700 dark:text-slate-200"
                  >
                    <div class="flex items-center gap-2">
                      <span class="w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-700 text-[10px] font-bold flex items-center justify-center text-slate-600 dark:text-slate-300">
                        {idx + 1}
                      </span>
                      <span>{step.name}</span>
                    </div>
                    <ArrowRight className="w-3 h-3 text-slate-400" />
                  </a>
                ))}
              </div>

              <div class="pt-2">
                <a
                  href="/workflows"
                  class="w-full py-2.5 px-4 rounded-xl bg-purple-50 dark:bg-purple-950/60 hover:bg-purple-100 dark:hover:bg-purple-900/60 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/80 text-xs font-bold transition-all flex items-center justify-center gap-1.5"
                >
                  <span>Launch Pipeline</span>
                  <ArrowRight className="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 5. WHY CRAFTY TOOL? (Architecture & Privacy Benefits) -->
      <section class="p-8 sm:p-12 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-8">
        <div class="text-center space-y-2 max-w-2xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
            Why In-Browser Processing?
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            Client-side architecture designed for privacy-conscious developers, creators, and professionals.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2 shadow-2xs">
            <div class="w-9 h-9 rounded-xl bg-purple-100 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold">
              <Lock className="w-4 h-4" />
            </div>
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">Zero Server Uploads</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Files never leave your device. Processing happens strictly in local memory to minimize exposure of sensitive files.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2 shadow-2xs">
            <div class="w-9 h-9 rounded-xl bg-emerald-100 dark:bg-emerald-950/70 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold">
              <Zap className="w-4 h-4" />
            </div>
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">Local Browser Processing</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Tools use browser-native APIs, Web Workers and WebAssembly where appropriate — without sending your files to a remote processing server.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2 shadow-2xs">
            <div class="w-9 h-9 rounded-xl bg-blue-100 dark:bg-blue-950/70 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold">
              <HardDrive className="w-4 h-4" />
            </div>
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">No Arbitrary Server Quotas</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              No arbitrary server upload quotas — practical capacity depends directly on your browser and device memory.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2 shadow-2xs">
            <div class="w-9 h-9 rounded-xl bg-amber-100 dark:bg-amber-950/70 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold">
              <ShieldCheck className="w-4 h-4" />
            </div>
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">No Forced Watermarks</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              No forced Crafty Tool branding or mandatory watermarks on supported exports.
            </p>
          </div>
        </div>
      </section>

      <!-- 6. TOOL EXPLORER & CATALOG CTA -->
      <section class="space-y-6 pt-2">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2 text-xs font-bold text-purple-600 dark:text-purple-400 uppercase tracking-wider">
              <Sparkles className="w-3.5 h-3.5" />
              <span>Tool Explorer</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              Featured Utilities
            </h2>
          </div>
          <a
            href="/tools"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition-colors shadow-sm"
          >
            <span>Explore All 55 Tools</span>
            <ArrowRight className="w-3.5 h-3.5" />
          </a>
        </div>

        <InteractiveToolExplorer client:load categories={CATEGORIES} tools={TOOLS} limit={8} showExploreAllButton={true} />
      </section>
    </div>
  </div>
</BaseLayout>
