---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Shield, Zap, Lock, Globe, CheckCircle2, Cpu } from 'lucide-react';

const origin = Astro.url.origin;
---

<BaseLayout
  title="About FreeTools — Fast, In-Browser Privacy-First Utilities"
  description="Learn about FreeTools' mission, architecture, and zero-upload philosophy. 55+ client-side web tools powered by modern browser APIs, Canvas, Web Workers, and WebAssembly where appropriate."
  canonicalUrl={`${origin}/about`}
  keywords={['about freetools', 'in-browser tools', 'privacy-first web tools', 'client side processing', 'zero upload utilities']}
>
  <!-- Ambient Gradient Background -->
  <div class="relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-tr from-purple-500/15 via-indigo-500/10 to-sky-500/10 blur-[120px] rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 space-y-16">
      <!-- Page Hero Header -->
      <header class="text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-purple-50 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800 shadow-2xs">
          <Shield className="w-3.5 h-3.5 text-purple-500" />
          Our Mission & Architecture
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
          The Everyday Browser Toolbox <br />
          <span class="bg-gradient-to-r from-purple-600 via-indigo-500 to-sky-400 bg-clip-text text-transparent">
            Engineered for Total Privacy
          </span>
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
          FreeTools was founded on a simple premise: everyday digital tasks should never require surrendering your private files, waiting in cloud server queues, or paying recurring subscription fees.
        </p>
      </header>

      <!-- Key Pillars Grid -->
      <section class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="p-6 rounded-3xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold">
            <Lock className="w-5 h-5" />
          </div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">0 Server Uploads</h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Your images, PDFs, videos, and code snippets stay in your device RAM. Processing runs 100% inside your browser sandbox.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/70 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold">
            <Zap className="w-5 h-5" />
          </div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Local Device Processing</h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Tasks run directly on your device without uploading data to a remote processing server.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950/70 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold">
            <Globe className="w-5 h-5" />
          </div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Free Browser Tools</h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            No accounts, no subscriptions, no arbitrary server limits, and no forced watermarks on your generated memes, signatures, or files.
          </p>
        </div>
      </section>

      <!-- Why We Built FreeTools Story -->
      <section class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-6">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Why We Built FreeTools
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          <p>
            Many traditional online utilities require uploading documents, personal photos, or code snippets to remote cloud servers before processing them.
          </p>
          <p>
            This server-centric model introduces common drawbacks:
          </p>
          <ul class="space-y-2 pl-2">
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-4 h-4 text-emerald-500 flex-shrink-0 mt-1" />
              <span><strong>Data Exposure:</strong> Uploading sensitive contracts, financial records, or proprietary source code to remote servers introduces unnecessary third-party risk.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-4 h-4 text-emerald-500 flex-shrink-0 mt-1" />
              <span><strong>Network Bottlenecks:</strong> Uploading large multi-megabyte media files over mobile or slow connections wastes bandwidth and time.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-4 h-4 text-emerald-500 flex-shrink-0 mt-1" />
              <span><strong>Usage Friction:</strong> Forced account registration, credit card prompts, and arbitrary daily rate limits.</span>
            </li>
          </ul>
          <p>
            FreeTools was built on a different model: <strong>Local & Private by Design</strong>. FreeTools uses browser technologies such as WebAssembly, Web Workers, Canvas, Web Crypto, and native JavaScript APIs where appropriate for each tool.
          </p>
        </div>
      </section>

      <!-- Technical Architecture Breakdown -->
      <section class="space-y-6">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Under the Hood: How It Works
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <div class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
              <Cpu className="w-4 h-4 text-purple-500" />
              <span>HTML5 Canvas & WebGL</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Powers instant image cropping, filters, upscaling, EXIF stripping, and watermarking directly inside your GPU-accelerated graphics context.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <div class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
              <Cpu className="w-4 h-4 text-emerald-500" />
              <span>Web Cryptography API</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Provides hardware-grade SHA-256, SHA-512, and HMAC hashing using native browser <code class="text-[11px] font-mono">crypto.subtle</code> primitives.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <div class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
              <Cpu className="w-4 h-4 text-blue-500" />
              <span>PDF-Lib & PDF.js</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Merges, splits, extracts, rotates, and stamps page numbers onto PDF binary streams client-side without any server roundtrips.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <div class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
              <Cpu className="w-4 h-4 text-amber-500" />
              <span>MediaRecorder & AudioContext</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Enables local screen and audio recording in browser-supported formats such as WebM with zero watermark branding.
            </p>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-purple-900/40 via-indigo-950/40 to-slate-950 border border-purple-500/20 text-center space-y-5">
        <h2 class="text-2xl sm:text-3xl font-black text-white">
          Explore All 55+ Free Utilities
        </h2>
        <p class="text-sm text-purple-200/80 max-w-lg mx-auto">
          Start compressing images, merging PDFs, debugging code, and running calculations right now in your browser.
        </p>
        <div>
          <a
            href="/tools"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-sm transition-all shadow-md shadow-purple-500/25 cursor-pointer"
          >
            <span>Explore All 55 Tools</span>
            <span class="text-xs">→</span>
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
