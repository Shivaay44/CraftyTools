---

{tool ? (
  <ToolLayout tool={tool} howItWorksSteps={toolContent.steps} faqs={toolContent.faqs}>
    <ToolIslandRenderer client:load toolSlug={slug!} />
  </ToolLayout>
) : (
  <div class="max-w-md mx-auto my-20 p-8 text-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl">
    <h1 class="text-3xl font-black text-slate-900 dark:text-white mb-2">404 - Tool Not Found</h1>
    <p class="text-slate-600 dark:text-slate-400 mb-6 text-sm">
      The requested tool "{slug}" does not exist or is not implemented yet.
    </p>
    <a href="/" class="px-5 py-2.5 rounded-xl font-bold bg-blue-600 text-white text-sm hover:bg-blue-500 transition-colors inline-block">
      Return to Home
    </a>
  </div>
)}
