---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { CATEGORIES, TOOLS } from '../../data/tools';
import { InteractiveToolExplorer } from '../../components/home/InteractiveToolExplorer';
import { generateHomePageSchemaGraph } from '../../lib/seo/schemaGenerators';
import { Sparkles, ShieldCheck } from 'lucide-react';

const origin = Astro.url.origin;
const pageUrl = `${origin}/tools`;

// Schema.org Graph for Tools Catalog
const catalogSchemaGraph = generateHomePageSchemaGraph({
  origin,
  tools: TOOLS,
  ogImageUrl: `${origin}/favicon.svg`,
});
---

<BaseLayout
  title="All 55+ Free Online In-Browser Tools & Utilities — Crafty Tool"
  description="Browse all 55+ client-side digital utilities for image optimization, PDF manipulation, developer workflows, text processing, and calculations with zero server uploads."
  canonicalUrl={pageUrl}
  keywords={[
    'online tools catalog',
    'free browser utilities',
    'developer tools online',
    'image tools online',
    'pdf tools online',
    'privacy first tools',
    'crafty tool directory',
  ]}
>
  <JsonLd schema={catalogSchemaGraph} />

  <div class="relative overflow-hidden">
    <!-- Ambient Background Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[850px] h-[350px] bg-gradient-to-tr from-purple-600/15 via-indigo-600/10 to-sky-500/10 blur-[130px] rounded-full pointer-events-none -z-10 animate-aurora"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-10">
      <!-- Catalog Header -->
      <header class="text-center space-y-4 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-purple-50 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800 shadow-2xs">
          <Sparkles className="w-3.5 h-3.5 text-purple-500" />
          <span>Full Tool Ecosystem</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
          All 55+ In-Browser Utilities
        </h1>

        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto">
          Every tool runs directly inside your web browser. Filter by category, search by task, or bookmark your favorite utilities locally.
        </p>

        <div class="flex items-center justify-center gap-4 text-xs font-semibold text-slate-500 dark:text-slate-400 pt-1">
          <span class="flex items-center gap-1">
            <ShieldCheck className="w-4 h-4 text-emerald-500" /> 0 Server Uploads
          </span>
          <span>•</span>
          <span>No Account Required</span>
          <span>•</span>
          <span>100% Free Forever</span>
        </div>
      </header>

      <!-- Complete Interactive Catalog Explorer -->
      <InteractiveToolExplorer client:load categories={CATEGORIES} tools={TOOLS} />
    </div>
  </div>
</BaseLayout>
