---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Mail, MessageSquare, Bug, Sparkles, Send, CheckCircle2, HelpCircle } from 'lucide-react';

const origin = Astro.url.origin;
---

<BaseLayout
  title="Contact Us & Feedback — Crafty Tool"
  description="Have feedback, feature requests, or bug reports for Crafty Tool? Reach out to our engineering team or submit a message."
  canonicalUrl={`${origin}/contact`}
  keywords={['contact crafty tool', 'feedback', 'bug report', 'support', 'feature request']}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 space-y-16">
    <!-- Header -->
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-purple-50 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800 shadow-2xs">
        <MessageSquare className="w-3.5 h-3.5" />
        Get in Touch
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        We'd Love to Hear From You
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-xl mx-auto leading-relaxed">
        Whether you have a suggestion for a new utility tool, encountered a bug, or want to report feedback, drop us a message below.
      </p>
    </header>

    <!-- Support Channel Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2 text-center">
        <div class="w-10 h-10 rounded-2xl bg-purple-100 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 flex items-center justify-center mx-auto">
          <Sparkles className="w-5 h-5" />
        </div>
        <h2 class="text-base font-bold text-slate-900 dark:text-white">Feature Requests</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Suggest new calculators, formatters, or converters.</p>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2 text-center">
        <div class="w-10 h-10 rounded-2xl bg-red-100 dark:bg-red-950/70 text-red-600 dark:text-red-400 flex items-center justify-center mx-auto">
          <Bug className="w-5 h-5" />
        </div>
        <h2 class="text-base font-bold text-slate-900 dark:text-white">Bug Reports</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Let us know if a tool misbehaves on your device.</p>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2 text-center">
        <div class="w-10 h-10 rounded-2xl bg-emerald-100 dark:bg-emerald-950/70 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto">
          <Mail className="w-5 h-5" />
        </div>
        <h2 class="text-base font-bold text-slate-900 dark:text-white">Partnerships</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">General feedback and community inquiries.</p>
      </div>
    </div>

    <!-- Interactive Contact Form -->
    <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-lg space-y-6">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
        Send Us a Message
      </h2>

      <form id="contact-form" class="space-y-4" onsubmit="event.preventDefault(); document.getElementById('contact-success').classList.remove('hidden'); document.getElementById('contact-submit-btn').disabled = true;">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400" for="name">
              Your Name
            </label>
            <input
              type="text"
              id="name"
              required
              placeholder="e.g. Alex Miller"
              class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-medium focus:ring-2 focus:ring-purple-500 focus:outline-none text-sm"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400" for="email">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              required
              placeholder="alex@example.com"
              class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-medium focus:ring-2 focus:ring-purple-500 focus:outline-none text-sm"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400" for="topic">
            Topic
          </label>
          <select
            id="topic"
            class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-medium focus:ring-2 focus:ring-purple-500 focus:outline-none text-sm"
          >
            <option value="feature">✨ Suggest a New Tool</option>
            <option value="bug">🐛 Report a Bug / Malfunction</option>
            <option value="feedback">💬 General Feedback</option>
            <option value="privacy">🔒 Privacy Question</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400" for="message">
            Message
          </label>
          <textarea
            id="message"
            required
            rows="5"
            placeholder="Tell us more about your suggestion or the issue you experienced..."
            class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-medium focus:ring-2 focus:ring-purple-500 focus:outline-none text-sm"
          ></textarea>
        </div>

        <div id="contact-success" class="hidden p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs font-bold flex items-center gap-2">
          <CheckCircle2 className="w-4 h-4 text-emerald-500 flex-shrink-0" />
          <span>Thank you! Your message has been received. Our team will review it shortly.</span>
        </div>

        <button
          type="submit"
          id="contact-submit-btn"
          class="w-full sm:w-auto px-8 py-3.5 rounded-2xl font-bold text-sm bg-gradient-to-r from-purple-600 via-indigo-600 to-sky-500 hover:from-purple-500 hover:to-sky-400 text-white flex items-center justify-center gap-2 shadow-md shadow-purple-500/20 transition-all cursor-pointer"
        >
          <Send className="w-4 h-4" />
          <span>Send Message</span>
        </button>
      </form>
    </div>

    <!-- Quick FAQ -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <HelpCircle className="w-5 h-5 text-purple-500" />
        <span>Frequently Asked Questions</span>
      </h2>
      <div class="space-y-3">
        <details class="border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900 p-4">
          <summary class="font-bold text-sm text-slate-900 dark:text-white cursor-pointer select-none">
            How fast are new tools added to Crafty Tool?
          </summary>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            We regularly add and improve client-side utilities based on community feedback and new browser capabilities. If a requested tool is feasible with client-side Web APIs, we prioritize its implementation!
          </p>
        </details>

        <details class="border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900 p-4">
          <summary class="font-bold text-sm text-slate-900 dark:text-white cursor-pointer select-none">
            Can I request custom enterprise features?
          </summary>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Yes! Send us an inquiry via the form above, and we can discuss specialized in-browser workflows or custom utility components.
          </p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
