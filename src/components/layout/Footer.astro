---
import { CATEGORIES } from '../../data/tools';
import Logo from './Logo.astro';
---

<footer class="w-full bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 mt-auto transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand & Tagline -->
      <div class="space-y-4 md:col-span-1">
        <Logo size="md" />
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          55+ fast, client-side web utilities built for developers, creators, and professionals. Private by Design.
        </p>
      </div>

      <!-- Categories Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-4">
          Tool Categories
        </h3>
        <ul class="space-y-2 text-sm">
          {CATEGORIES.map((cat) => (
            <li>
              <a href={`/tools#${cat.id}`} class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-4">
          Quick Links
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Home</a></li>
          <li><a href="/tools" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">All 55 Tools</a></li>
          <li><a href="/workflows" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Workflows Engine</a></li>
          <li><a href="/about" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">About FreeTools</a></li>
          <li><a href="/privacy" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Terms of Service</a></li>
          <li><a href="/contact" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Security & Privacy Note -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-4">
          Private by Design
        </h3>
        <p class="text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          Uploaded files and tool inputs are processed locally in your browser memory. Files are not sent to FreeTools servers.
        </p>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
      <p>© {new Date().getFullYear()} FreeTools. All rights reserved.</p>
      <div class="flex space-x-4 mt-4 sm:mt-0">
        <a href="/privacy" class="hover:underline">Privacy</a>
        <a href="/terms" class="hover:underline">Terms</a>
        <a href="/contact" class="hover:underline">Contact</a>
      </div>
    </div>
  </div>
</footer>
